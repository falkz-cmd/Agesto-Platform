# Base da API do Agesto. Em dev com mocks ligados, o valor é irrelevante
# (o MSW intercepta as chamadas). Aponta pro backend real quando ele subir.
VITE_API_BASE_URL=http://localhost:5000

# Liga a camada de mock (MSW). "true" em dev enquanto não há banco/API no ar;
# "false" para consumir a API real sem mudar código.
VITE_USE_MOCKS=true
